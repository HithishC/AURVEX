# Copy this file to .env for local development and fill in real
# values there. Never commit the real .env file -- it is already
# listed in .gitignore, along with any service-account JSON file.

# --- Existing app config (unchanged by the Firestore migration) ----

# Must be at least 32 characters. Generate one real value per
# environment (local/staging/production) and never reuse it. Do not
# change the value already configured on Render for the running
# production service -- rotating it invalidates every existing login
# session.
JWT_SECRET=replace-with-a-real-random-secret-at-least-32-chars

# Optional. If unset, defaults to backend/shadowshield.db (see
# backend/config.py). Point this at a persistent-disk mount path on
# Render once one is attached, to survive redeploys.
SHADOWSHIELD_DB_PATH=

# --- Database backend selector --------------------------------------

# "sqlite" (default) or "firestore". Leave unset / "sqlite" until the
# Firestore path has been verified end-to-end against real
# credentials and a verified SQLite backup has been imported.
DB_BACKEND=sqlite

# --- Firebase / Firestore (only required when DB_BACKEND=firestore) -

# Your Firebase project's id, e.g. "aurvex-prod".
FIREBASE_PROJECT_ID=

# The FULL contents of a Firebase service-account JSON key file,
# pasted here as a single-line JSON string. Never commit this value
# anywhere. On Render, set it via the dashboard's environment variable
# editor (not in a file checked into git).
#
# Example shape (placeholder values only):
# {"type":"service_account","project_id":"aurvex-prod","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@aurvex-prod.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
FIREBASE_SERVICE_ACCOUNT_JSON=
